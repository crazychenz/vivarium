# Defaults. Override any of these in config.local.env (same directory) or the environment.

# --- Base image (Ubuntu LTS cloud image) ---
UBUNTU_RELEASE="${UBUNTU_RELEASE:-noble}"          # 24.04 LTS
UBUNTU_ARCH="${UBUNTU_ARCH:-amd64}"
IMG_NAME="${IMG_NAME:-${UBUNTU_RELEASE}-server-cloudimg-${UBUNTU_ARCH}}"
UBUNTU_BASE_URL="${UBUNTU_BASE_URL:-https://cloud-images.ubuntu.com/${UBUNTU_RELEASE}/current}"
# microvm cannot boot from the image's own bootloader, so it needs the kernel and
# initrd unpacked from the same image build. Canonical publishes these in unpacked/.
KERNEL_URL="${KERNEL_URL:-${UBUNTU_BASE_URL}/unpacked/${IMG_NAME}-vmlinuz-generic}"
INITRD_URL="${INITRD_URL:-${UBUNTU_BASE_URL}/unpacked/${IMG_NAME}-initrd-generic}"

# --- Layout ---
STATE_DIR="${STATE_DIR:-$ROOT/state}"
BASE_DIR="$STATE_DIR/base"
VM_DIR="$STATE_DIR/vms"
KEY_DIR="$STATE_DIR/keys"
RUN_DIR="$STATE_DIR/run"
LOG_DIR="$STATE_DIR/logs"

# --- Execution VM (where all agent work happens) ---
EXEC_MEM="${EXEC_MEM:-4G}"
EXEC_CPUS="${EXEC_CPUS:-4}"
EXEC_DISK="${EXEC_DISK:-20G}"
EXEC_SSH_PORT="${EXEC_SSH_PORT:-2222}"             # host loopback only
EXEC_USER="agent"
EXEC_HOSTNAME="workspace"

# --- Agent VM (runs the Claude Code container) ---
AGENT_MEM="${AGENT_MEM:-2G}"
AGENT_CPUS="${AGENT_CPUS:-2}"
AGENT_DISK="${AGENT_DISK:-10G}"
AGENT_SSH_PORT="${AGENT_SSH_PORT:-2223}"           # host loopback only, for the operator
AGENT_USER="runner"
AGENT_HOSTNAME="agent-host"

# --- Host services exposed to the agent VM (and nothing else) ---
GATEWAY_PORT="${GATEWAY_PORT:-9000}"               # MCP gateway
PROXY_PORT="${PROXY_PORT:-3128}"                   # Anthropic API forwarder
GUEST_GATEWAY_IP="10.0.2.100"                      # how the agent VM sees them
GUEST_PROXY_IP="10.0.2.101"

# --- Operator access: this public key may SSH into both VMs ---
OPERATOR_PUBKEY="${OPERATOR_PUBKEY:-}"             # auto-detected from ~/.ssh if empty

# --- QEMU ---
QEMU_BIN="${QEMU_BIN:-qemu-system-x86_64}"
QEMU_SANDBOX="${QEMU_SANDBOX:-on}"                 # seccomp; set to off if qemu dies with "Bad system call"
PROVISION_TIMEOUT="${PROVISION_TIMEOUT:-1200}"     # seconds
